<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>DiscordVPNManager</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>5</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="logo-transparent.png" />
    <None Remove="Aplicar-VPN-Discord.ps1" />
    <None Remove="tunnel-launcher.ps1" />
    <None Remove="discord-waiter.ps1" />
    <None Remove="wintun.dll" />
    <None Remove="sing-box.exe" />
    <EmbeddedResource Include="logo-transparent.png" LogicalName="logo-transparent.png" />
    <EmbeddedResource Include="Aplicar-VPN-Discord.ps1" LogicalName="Aplicar-VPN-Discord.ps1" />
    <EmbeddedResource Include="tunnel-launcher.ps1" LogicalName="tunnel-launcher.ps1" />
    <EmbeddedResource Include="discord-waiter.ps1" LogicalName="discord-waiter.ps1" />
    <EmbeddedResource Include="wintun.dll" LogicalName="wintun.dll" />
    <EmbeddedResource Include="sing-box.exe" LogicalName="sing-box.exe" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>